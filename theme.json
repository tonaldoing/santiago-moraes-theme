{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1240px",
			"wideSize": "1440px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#1F3C57",
					"name": "Tinta (Navy)"
				},
				{
					"slug": "paper",
					"color": "#E9DCC6",
					"name": "Papel (Beige)"
				},
				{
					"slug": "ochre",
					"color": "#E08B3E",
					"name": "Ocre"
				},
				{
					"slug": "brick",
					"color": "#A8341C",
					"name": "Ladrillo"
				},
				{
					"slug": "cream",
					"color": "#F4E9D6",
					"name": "Crema"
				},
				{
					"slug": "warm",
					"color": "#D9CBB2",
					"name": "Cálido"
				},
				{
					"slug": "muted",
					"color": "#C9B896",
					"name": "Arena"
				},
				{
					"slug": "brown",
					"color": "#3A2A1C",
					"name": "Marrón"
				},
				{
					"slug": "olive",
					"color": "#6B573C",
					"name": "Oliva"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "'Archivo Black', sans-serif",
					"slug": "heading",
					"name": "Archivo Black"
				},
				{
					"fontFamily": "'Newsreader', Georgia, serif",
					"slug": "body",
					"name": "Newsreader"
				},
				{
					"fontFamily": "'DM Mono', monospace",
					"slug": "mono",
					"name": "DM Mono"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "12px",
					"name": "Chico"
				},
				{
					"slug": "medium",
					"size": "17px",
					"name": "Mediano"
				},
				{
					"slug": "large",
					"size": "22px",
					"name": "Grande"
				},
				{
					"slug": "x-large",
					"size": "52px",
					"name": "Extra Grande"
				},
				{
					"slug": "xx-large",
					"size": "104px",
					"name": "Hero"
				}
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vw", "%"]
		}
	},
	"styles": {
		"color": {
			"background": "#E9DCC6",
			"text": "#3A2A1C"
		},
		"typography": {
			"fontFamily": "'Newsreader', Georgia, serif",
			"fontSize": "17px",
			"lineHeight": "1.55"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "'Archivo Black', sans-serif",
					"fontWeight": "400",
					"textTransform": "uppercase"
				},
				"color": {
					"text": "#1F3C57"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(48px, 8vw, 124px)",
					"lineHeight": "0.84",
					"letterSpacing": "-0.045em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(30px, 3.6vw, 52px)",
					"lineHeight": "0.92",
					"letterSpacing": "-0.03em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(18px, 1.7vw, 24px)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.01em"
				}
			},
			"link": {
				"color": {
					"text": "#A8341C"
				},
				":hover": {
					"color": {
						"text": "#1F3C57"
					}
				}
			},
			"button": {
				"typography": {
					"fontFamily": "'Archivo Black', sans-serif",
					"fontSize": "13px",
					"fontWeight": "400",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				},
				"color": {
					"background": "#1F3C57",
					"text": "#F4E9D6"
				},
				"border": {
					"radius": "0",
					"width": "3px",
					"color": "#1F3C57"
				}
			}
		}
	}
}
